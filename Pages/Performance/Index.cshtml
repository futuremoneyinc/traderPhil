@page
@model TraderPhil.V4.Web.Pages.Performance.IndexModel
@{
    ViewData["Title"] = "Performance";
}

<div class="container py-4">

    @if (Model.AvailableUeis.Count == 0)
    {
        <div class="tp-card">
            <div class="tp-empty">
                Your account isn't linked to a trading profile yet. Reach out to your administrator to get access.
            </div>
        </div>
    }
    else
    {
        @* If the user has more than one UEI, render a small switcher. *@
        @if (Model.AvailableUeis.Count > 1)
        {
            <div class="d-flex justify-content-end mb-3">
                <form method="get" class="d-flex gap-2 align-items-center">
                    <label class="form-label mb-0 small text-secondary" for="ueiSelect">Account</label>
                    <select id="ueiSelect" name="uei" class="form-select form-select-sm w-auto"
                            onchange="this.form.submit()">
                        @foreach (var u in Model.AvailableUeis)
                        {
                            <option value="@u" selected="@(u == Model.CurrentUei)">UEI @u</option>
                        }
                    </select>
                </form>
            </div>
        }

        @* ============================================================
           PROFIT LADDER (read-only) — set tone at the top of the page
           ============================================================ *@
        <section class="tp-card tp-ladder-card" id="profitLadderCard">

            <header class="tp-ladder-header">
                <div class="tp-ladder-title-block">
                    <div class="tp-ladder-icon" aria-hidden="true">
                        <svg viewBox="0 0 32 32" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M8 28 L8 4" />
                            <path d="M24 28 L24 4" />
                            <path d="M8 22 L24 22" />
                            <path d="M8 16 L24 16" />
                            <path d="M8 10 L24 10" />
                            <path d="M6 26 L12 20 L18 22 L26 12" stroke-width="2.2" />
                            <path d="M22 12 L26 12 L26 16" stroke-width="2.2" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="tp-ladder-title">Profit Ladder</h2>
                        <div class="tp-ladder-subtitle">Climb the ladder. Lock in profits. Recycle and repeat.</div>
                    </div>
                </div>

                @if (Model.HasProfitTargets)
                {
                    <span class="tp-ladder-pill active">
                        <span class="tp-ladder-pill-dot"></span> Active
                    </span>
                }
                else
                {
                    <span class="tp-ladder-pill inactive">
                        <span class="tp-ladder-pill-dot"></span> Not configured
                    </span>
                }
            </header>

            @if (!Model.HasProfitTargets)
            {
                <div class="tp-ladder-body tp-ladder-empty-perf">
                    <p>No profit targets yet. Set one up on the
                       <a asp-page="/Strategy/Index" class="tp-ladder-link">Strategy page</a> to start
                       climbing.
                    </p>
                </div>
            }
            else
            {
                var totalStr     = Model.ProfitTargets!.TotalCount.ToString("N0");
                var availStr     = Model.ProfitTargets.AvailableCount.ToString("N0");
                var consumedStr  = Model.ProfitTargets.ConsumedCount.ToString("N0");
                var totalOrigStr = Model.ProfitTargets.TotalCurrentProfitTarget.ToString("$#,##0.00");
                var rangeStr     = Model.ProfitTargets.MinOriginalProfitTarget.ToString("$#,##0.00")
                                   + " – " + Model.ProfitTargets.MaxOriginalProfitTarget.ToString("$#,##0.00");

                var progressPct  = Model.ProfitTargets.ProgressPercent;
                var progressStr  = progressPct.ToString("0.00") + "%";
                var progressFillStyle = "width: " + progressPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

                var totalCount = Model.ProfitTargets.TotalCount;
                var q25 = ((int)(totalCount * 0.25)).ToString("N0");
                var q50 = ((int)(totalCount * 0.50)).ToString("N0");
                var q75 = ((int)(totalCount * 0.75)).ToString("N0");
                var q100 = totalCount.ToString("N0");

                <div class="tp-ladder-body">

                    <div class="tp-ladder-progress-row">
                        <div class="tp-ladder-progress-block tp-ladder-progress-current">
                            <div class="tp-ladder-progress-label">Your Progress</div>
                            <div class="tp-ladder-progress-value">@progressStr</div>
                        </div>
                        <div class="tp-ladder-progress-block tp-ladder-progress-goal">
                            <div class="tp-ladder-progress-label">Cumulative Target</div>
                            <div class="tp-ladder-progress-value">@totalOrigStr</div>
                        </div>
                    </div>

                    <div class="tp-ladder-track-wrap">
                        <div class="tp-ladder-track">
                            <div class="tp-ladder-track-fill" style="@progressFillStyle"></div>
                            <span class="tp-ladder-tick" style="left:25%"></span>
                            <span class="tp-ladder-tick" style="left:50%"></span>
                            <span class="tp-ladder-tick" style="left:75%"></span>
                            <span class="tp-ladder-trophy" aria-label="Goal">
                                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M8 21h8" />
                                    <path d="M12 17v4" />
                                    <path d="M7 4h10v5a5 5 0 0 1-10 0V4z" />
                                    <path d="M17 5h2a2 2 0 0 1 2 2v1a3 3 0 0 1-3 3" />
                                    <path d="M7 5H5a2 2 0 0 0-2 2v1a3 3 0 0 0 3 3" />
                                </svg>
                            </span>
                        </div>

                        <div class="tp-ladder-axis">
                            <span class="tp-ladder-axis-stop tp-ladder-axis-start">
                                <span class="tp-ladder-axis-value">0</span>
                                <span class="tp-ladder-axis-pct">Start</span>
                            </span>
                            <span class="tp-ladder-axis-stop">
                                <span class="tp-ladder-axis-value">@q25</span>
                                <span class="tp-ladder-axis-pct">25%</span>
                            </span>
                            <span class="tp-ladder-axis-stop">
                                <span class="tp-ladder-axis-value">@q50</span>
                                <span class="tp-ladder-axis-pct">50%</span>
                            </span>
                            <span class="tp-ladder-axis-stop">
                                <span class="tp-ladder-axis-value">@q75</span>
                                <span class="tp-ladder-axis-pct">75%</span>
                            </span>
                            <span class="tp-ladder-axis-stop tp-ladder-axis-goal">
                                <span class="tp-ladder-axis-value">@q100</span>
                                <span class="tp-ladder-axis-pct">100%</span>
                            </span>
                        </div>
                    </div>

                    <div class="tp-ladder-tiles">
                        <div class="tp-ladder-tile">
                            <div class="tp-ladder-tile-icon tp-ladder-tile-icon-targets">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <circle cx="12" cy="12" r="6" />
                                    <circle cx="12" cy="12" r="2" />
                                </svg>
                            </div>
                            <div>
                                <div class="tp-ladder-tile-label">Total Targets</div>
                                <div class="tp-ladder-tile-value">@totalStr</div>
                            </div>
                        </div>

                        <div class="tp-ladder-tile">
                            <div class="tp-ladder-tile-icon tp-ladder-tile-icon-available">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 12 L10 17 L20 7" />
                                </svg>
                            </div>
                            <div>
                                <div class="tp-ladder-tile-label">Available</div>
                                <div class="tp-ladder-tile-value">@availStr</div>
                            </div>
                        </div>

                        <div class="tp-ladder-tile">
                            <div class="tp-ladder-tile-icon tp-ladder-tile-icon-consumed">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 12a9 9 0 1 1-3.4-7" />
                                    <path d="M21 4v6h-6" />
                                </svg>
                            </div>
                            <div>
                                <div class="tp-ladder-tile-label">Consumed</div>
                                <div class="tp-ladder-tile-value">@consumedStr</div>
                            </div>
                        </div>

                        <div class="tp-ladder-tile">
                            <div class="tp-ladder-tile-icon tp-ladder-tile-icon-range">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M12 6 L12 18" />
                                    <path d="M9 8.5a3 3 0 0 1 3-2.5h.5a2.5 2.5 0 0 1 0 5h-3a2.5 2.5 0 0 0 0 5H13a3 3 0 0 0 3-2.5" />
                                </svg>
                            </div>
                            <div>
                                <div class="tp-ladder-tile-label">Range</div>
                                <div class="tp-ladder-tile-value tp-ladder-tile-value-sm">@rangeStr</div>
                            </div>
                        </div>
                    </div>

                </div>
            }
        </section>

        <partial name="_StrategyCard" model="Model.SymbiCoreCard" />

        <partial name="_StrategyCard" model="Model.WoolChipperCard" />

        <partial name="_TreasuryCard" model="Model.TreasuryCard" />
    }

</div>
