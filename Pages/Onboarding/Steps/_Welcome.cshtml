@model TraderPhil.V4.Web.Pages.Onboarding.IndexModel

<section class="tp-ob-hero">
    <div class="tp-ob-hero-duck" aria-hidden="true">
        <partial name="_Duck" />
    </div>

    <h1 class="tp-ob-hero-title">Welcome aboard.</h1>
    <p class="tp-ob-hero-lead">
        I'm Commander Quackers. Give me a few minutes and I'll get you set up, connected,
        and watching TraderPhil work — before you decide anything.
    </p>

    <div class="tp-ob-hero-cta">
        <a class="tp-ob-btn tp-ob-btn-google" href="/Account/SignIn?returnUrl=%2FOnboarding">
            <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
                <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.4 29.3 35 24 35c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.3-.4-3.5z"/>
                <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13 24 13c3.1 0 5.9 1.2 8 3.1l5.7-5.7C34.6 6.1 29.6 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.3 26.7 36 24 36c-5.3 0-9.7-2.6-11.3-6.9l-6.5 5C9.5 39.6 16.1 44 24 44z"/>
                <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.1-4.1 5.6l6.2 5.2C41 36.4 44 30.7 44 24c0-1.3-.1-2.3-.4-3.5z"/>
            </svg>
            <span>Continue with Google</span>
        </a>
        <p class="tp-ob-hero-fineprint">Free to start. No card required. Cancel anytime.</p>
    </div>

    <ul class="tp-ob-trust">
        <li>
            <span class="tp-ob-trust-icon">&#128274;</span>
            Your Kraken keys never allow withdrawals — we reject any key that can move funds.
        </li>
        <li>
            <span class="tp-ob-trust-icon">&#128064;</span>
            See the system trade on your own account before you commit.
        </li>
        <li>
            <span class="tp-ob-trust-icon">&#128100;</span>
            You stay in control. Pause or disconnect in one click.
        </li>
    </ul>
</section>
