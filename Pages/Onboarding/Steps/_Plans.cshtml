@model TraderPhil.V4.Web.Pages.Onboarding.IndexModel
@using TraderPhil.V4.Web.Models
@using TraderPhil.V4.Web.Services

<section class="tp-ob-step tp-ob-plans">
    <header class="tp-ob-step-head tp-text-center">
        <div class="tp-ob-plans-duck" aria-hidden="true"><partial name="_Duck" /></div>
        <h1 class="tp-ob-step-title">Now that you've seen it — pick your plan</h1>
        <p class="tp-ob-step-sub">
            Plans are sized by how many coins you want TraderPhil trading. Every plan starts with a
            <strong>14-day free trial</strong> — you won't be charged until it ends, and you can cancel anytime.
        </p>
    </header>

    <div class="tp-ob-plan-grid">
        @foreach (var plan in OnboardingPlans.All)
        {
            var pricing = Model.PlanPricing.TryGetValue(plan.Slug, out var pr) ? pr : null;
            <form method="post" asp-page-handler="ChoosePlan"
                  class="tp-ob-plan-card @(plan.Highlighted ? "highlighted" : "")">
                <input type="hidden" name="plan" value="@plan.Slug" />
                @if (plan.Highlighted)
                {
                    <div class="tp-ob-plan-flag">Most popular</div>
                }
                <div class="tp-ob-plan-name">@plan.Name</div>

                <div class="tp-ob-plan-price">
                    @if (pricing is not null)
                    {
                        <span class="tp-ob-plan-amount">@pricing.Display</span>
                    }
                    else
                    {
                        <span class="tp-ob-plan-amount tp-ob-plan-amount-sm">14-day free trial</span>
                    }
                </div>

                <div class="tp-ob-plan-coins">@plan.CoinLabel</div>
                <div class="tp-ob-plan-guidance">@plan.AccountGuidance</div>
                <div class="tp-ob-plan-tagline">@plan.Tagline</div>

                <ul class="tp-ob-plan-features">
                    @foreach (var f in plan.Features)
                    {
                        <li>&#10003; @f</li>
                    }
                </ul>

                <button type="submit"
                        class="tp-ob-btn @(plan.Highlighted ? "tp-ob-btn-primary" : "tp-ob-btn-outline") tp-ob-plan-btn">
                    Start 14-day free trial
                </button>
            </form>
        }
    </div>

    <form method="post" asp-page-handler="ChoosePlan" class="tp-ob-plans-skip">
        <input type="hidden" name="plan" value="skip" />
        <button type="submit" class="tp-ob-linkbtn">I'll choose later — take me in</button>
    </form>

    @* ---- Protection Mode reassurance ---- *@
    <div class="tp-ob-protect">
        <div class="tp-ob-protect-head">
            <span class="tp-ob-protect-shield" aria-hidden="true">&#128737;</span>
            <div>
                <h2 class="tp-ob-protect-title">If a subscription ever lapses, your positions are protected</h2>
                <p class="tp-ob-protect-sub">
                    We never abandon open trades. Here's exactly what happens — and how much warning you get.
                </p>
            </div>
        </div>

        <ol class="tp-ob-timeline">
            @foreach (var m in ProtectionModePolicy.Timeline)
            {
                <li class="tp-ob-timeline-item phase-@m.Phase.ToString().ToLowerInvariant()">
                    <div class="tp-ob-timeline-day">Day @m.Day</div>
                    <div class="tp-ob-timeline-body">
                        <div class="tp-ob-timeline-title">@m.Title</div>
                        <div class="tp-ob-timeline-detail">@m.Detail</div>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>
